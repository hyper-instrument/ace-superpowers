{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Shell",
        "command": "./hooks/run-hook.cmd cursor-traceback-current",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "sessionStart": [
      {
        "command": "./hooks/run-hook.cmd session-start"
      }
    ],
    "postToolUse": [
      {
        "matcher": "Shell",
        "command": "./hooks/run-hook.cmd post-tool-trace"
      },
      {
        "matcher": "Edit|Write|MultiEdit|WebFetch|WebSearch|CallMcpTool",
        "command": "./hooks/run-hook.cmd post-tool-trace"
      }
    ],
    "postToolUseFailure": [
      {
        "matcher": "Shell",
        "command": "./hooks/run-hook.cmd post-tool-trace"
      },
      {
        "matcher": "Edit|Write|MultiEdit|WebFetch|WebSearch|CallMcpTool",
        "command": "./hooks/run-hook.cmd post-tool-trace"
      }
    ],
    "stop": [
      {
        "command": "./hooks/run-hook.cmd stop-reflect"
      }
    ]
  }
}
